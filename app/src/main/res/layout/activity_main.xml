<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".MainActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- TOP APP BAR -->
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/topAppBar"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="?attr/colorSurface"
                android:paddingHorizontal="8dp"
                app:contentInsetStart="0dp"
                app:contentInsetEnd="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageButton
                        android:id="@+id/menuBtn"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_menu"
                        android:contentDescription="Menu"
                        android:tint="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/brandName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="DriveEasy"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:fontFamily="serif"
                        android:textColor="?attr/colorPrimary"
                        android:letterSpacing="-0.02" />

                    <ImageView
                        android:id="@+id/darkModeIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/ic_dark_mode"
                        android:tint="?attr/colorOnSurfaceVariant"
                        android:importantForAccessibility="no" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/darkModeToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="Toggle dark mode" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/balanceCard"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        app:cardBackgroundColor="?attr/colorPrimary"
                        app:cardCornerRadius="16dp">

                        <TextView
                            android:id="@+id/balanceText"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:paddingHorizontal="12dp"
                            android:gravity="center"
                            android:text="500 Credits"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="?attr/colorOnPrimary" />

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </com.google.android.material.appbar.MaterialToolbar>

            <!-- SEARCH BAR -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/searchCard"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="100dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardElevation="2dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_search"
                        android:tint="?attr/colorPrimary"
                        android:contentDescription="Search" />

                    <EditText
                        android:id="@+id/searchInput"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="10dp"
                        android:background="@null"
                        android:hint="Search for a car..."
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurface"
                        android:textColorHint="?attr/colorOnSurfaceVariant"
                        android:inputType="text"
                        android:maxLines="1"
                        android:imeOptions="actionSearch" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- SORT BUTTONS -->
            <LinearLayout
                android:id="@+id/sortRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sort:"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginEnd="8dp" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/sortToggleGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:checkedButton="@id/sortRatingBtn">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/sortRatingBtn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Rating"
                        android:textSize="12sp"
                        android:checkable="true"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/sortYearBtn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Year"
                        android:textSize="12sp"
                        android:checkable="true"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="12dp"
                        android:layout_marginStart="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/sortCostBtn"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Cost"
                        android:textSize="12sp"
                        android:checkable="true"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="12dp"
                        android:layout_marginStart="6dp" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

            </LinearLayout>

            <!-- CAR CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/carDisplayCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardElevation="4dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Car Image -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="200dp">

                        <ImageView
                            android:id="@+id/carImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_launcher_foreground" />

                        <ImageButton
                            android:id="@+id/favBtn"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="top|start"
                            android:layout_margin="12dp"
                            android:background="@drawable/bg_circle_white"
                            android:src="@drawable/ic_favorite_border"
                            android:contentDescription="Toggle favourite"
                            android:tint="#ef4444"
                            android:elevation="2dp" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/ratingBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|end"
                            android:layout_margin="12dp"
                            app:cardCornerRadius="100dp"
                            app:cardBackgroundColor="#E8FFFFFF"
                            app:cardElevation="2dp">

                            <RatingBar
                                android:id="@+id/ratingBar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:isIndicator="true"
                                android:numStars="5"
                                android:stepSize="0.1"
                                android:rating="4.8"
                                android:progressTint="@color/star_yellow"
                                android:padding="8dp"
                                android:scaleX="0.55"
                                android:scaleY="0.55" />

                        </com.google.android.material.card.MaterialCardView>

                        <!-- Type Badge -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/typeBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|start"
                            android:layout_margin="12dp"
                            app:cardCornerRadius="100dp"
                            app:cardBackgroundColor="?attr/colorPrimary">

                            <TextView
                                android:id="@+id/typeText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="3dp"
                                android:text="LUXURY"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnPrimary"
                                android:letterSpacing="0.04" />

                        </com.google.android.material.card.MaterialCardView>

                    </FrameLayout>

                    <!-- Car Info -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Name + Price -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/carName"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Tesla Model S"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:id="@+id/carPrice"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="$89"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    android:textColor="?attr/colorPrimary" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="/day"
                                    android:textSize="12sp"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:layout_marginStart="2dp" />

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Subtitle -->
                        <TextView
                            android:id="@+id/carSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="12dp"
                            android:text="Luxury Electric Sedan \u2022 2024"
                            android:textSize="13sp"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <!-- Specs Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="14dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginEnd="20dp">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_bolt"
                                    android:tint="?attr/colorOnSurfaceVariant"
                                    android:contentDescription="Kilometres" />

                                <TextView
                                    android:id="@+id/kilometresText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="5dp"
                                    android:text="15,000 km"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="?attr/colorOnSurfaceVariant" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginEnd="20dp">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_person"
                                    android:tint="?attr/colorOnSurfaceVariant"
                                    android:contentDescription="Seats" />

                                <TextView
                                    android:id="@+id/seatsText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="5dp"
                                    android:text="5 Seats"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="?attr/colorOnSurfaceVariant" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_work"
                                    android:tint="?attr/colorOnSurfaceVariant"
                                    android:contentDescription="Bags" />

                                <TextView
                                    android:id="@+id/bagsText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="5dp"
                                    android:text="2 Bags"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="?attr/colorOnSurfaceVariant" />

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Rent Now -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/rentBtn"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="Rent Now"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnPrimary"
                            app:backgroundTint="?attr/colorPrimary"
                            app:cornerRadius="14dp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- NEXT VEHICLE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nextBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Next Vehicle"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnPrimary"
                    android:paddingHorizontal="24dp"
                    app:backgroundTint="?attr/colorPrimary"
                    app:cornerRadius="100dp"
                    app:icon="@drawable/ic_arrow_forward"
                    app:iconTint="?attr/colorOnPrimary"
                    app:iconGravity="textEnd"
                    app:elevation="4dp" />

            </LinearLayout>

            <!-- FAVOURITES -->
            <TextView
                android:id="@+id/favouritesLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp"
                android:text="FAVORITES"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:letterSpacing="0.1" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/favouritesRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:clipToPadding="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_favourite" />

            <View
                android:layout_width="match_parent"
                android:layout_height="16dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
